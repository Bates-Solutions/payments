{
  "name": "@bates-solutions/clover",
  "version": "1.1.0",
  "description": "TypeScript wrapper for the Clover Ecommerce & Platform APIs with webhook support for Node.js and edge runtimes",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "keywords": [
    "clover",
    "clover-api",
    "clover-ecommerce",
    "payments",
    "payment-processing",
    "typescript",
    "nodejs",
    "backend",
    "webhooks",
    "ecommerce",
    "pos",
    "sdk",
    "api"
  ],
  "author": "Bates Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bates-Solutions/clover.git"
  },
  "bugs": {
    "url": "https://github.com/Bates-Solutions/clover/issues"
  },
  "homepage": "https://github.com/Bates-Solutions/clover#readme",
  "engines": {
    "node": ">=22"
  }
}
