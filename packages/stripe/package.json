{
  "name": "@bates-solutions/stripe",
  "version": "1.0.3",
  "description": "TypeScript wrapper for the Stripe API with webhook support for Node.js backends",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc"
  },
  "keywords": [
    "stripe",
    "stripe-api",
    "payments",
    "payment-processing",
    "typescript",
    "nodejs",
    "backend",
    "webhooks",
    "ecommerce",
    "sdk",
    "api"
  ],
  "author": "Bates Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbates/stripe.git"
  },
  "bugs": {
    "url": "https://github.com/mbates/stripe/issues"
  },
  "homepage": "https://github.com/mbates/stripe#readme",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "stripe": ">=17 <19"
  },
  "devDependencies": {
    "stripe": "^23.1.0"
  }
}
