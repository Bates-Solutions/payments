{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/core/index.ts", "src/server/index.ts"],
  "outputs": [
    {
      "name": "markdown",
      "path": "docs/api"
    }
  ],
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "disableGit": true,
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/Bates-Solutions/payments/blob/{gitRevision}/packages/stripe/src/{path}#L{line}",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "name": "@bates-solutions/stripe API Reference",
  "includeVersion": true,
  "categorizeByGroup": true,
  "categoryOrder": ["Core", "Server", "*"],
  "navigation": {
    "includeCategories": true,
    "includeGroups": true
  }
}
