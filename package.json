{
  "name": "@bates-solutions/payments-monorepo",
  "private": true,
  "description": "Workspace root for the Bates Solutions payment provider libraries. Not published.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bates-Solutions/payments.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "docs": "npm run docs --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test && npm run test:scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}
